<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Formulario de pedidos de venta -->
    <record id="view_order_form_ventas_unicah" model="ir.ui.view">
        <field name="name">sale.order.form.ventas.unicah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button
                    name="action_aprobar"
                    type="object"
                    string="Aprobar"
                    class="btn-primary"
                    groups="sales_team.group_sale_manager"
                    invisible="not pendiente_aprobacion"
                />
            </xpath>

            <xpath expr="//sheet" position="inside">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not pendiente_aprobacion"
                >
                    Este pedido supera los 50,000 y necesita aprobación
                    de un administrador de ventas antes de confirmarse.
                </div>
            </xpath>

            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="canal_venta"/>
                <field name="total_unidades"/>
                <field name="requiere_aprobacion"/>
                <field name="aprobado_por" readonly="1"/>
                <field name="pendiente_aprobacion" invisible="1"/>
            </xpath>

        </field>
    </record>

    <!-- Lista de pedidos de venta -->
    <record id="view_order_tree_ventas_unicah" model="ir.ui.view">
        <field name="name">sale.order.tree.ventas.unicah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="canal_venta" optional="show"/>
                <field name="total_unidades" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Búsqueda y filtros de pedidos -->
    <record id="view_sales_order_filter_ventas_unicah" model="ir.ui.view">
        <field name="name">sale.order.search.ventas.unicah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='user_id']" position="after">
                <field name="canal_venta"/>
            </xpath>

            <xpath expr="//search" position="inside">
                <filter
                    name="requiere_aprobacion"
                    string="Requiere aprobación"
                    domain="[('requiere_aprobacion', '=', True)]"
                />
                <filter
                    name="group_by_canal_venta"
                    string="Canal de venta"
                    context="{'group_by': 'canal_venta'}"
                />
            </xpath>

        </field>
    </record>

</odoo>
